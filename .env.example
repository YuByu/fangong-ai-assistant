# 服务端口（后端）
PORT=3000

# CodeBuddy 凭证（二选一或都填）
# 从 https://www.codebuddy.cn 获取 API Key
CODEBUDDY_API_KEY=
# 或使用 CLI 登录后的 auth token（codebuddy login）
CODEBUDDY_AUTH_TOKEN=

# 可选：自定义网关地址与运行环境
CODEBUDDY_BASE_URL=
CODEBUDDY_INTERNET_ENVIRONMENT=external

# 对外 API 接入口密钥（/api/v1/* 接口鉴权用）
# 设置后，外部系统可通过 POST /api/v1/chat 接入助手；留空则不启用 API 接入
API_ACCESS_KEY=
